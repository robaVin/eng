# ---- AI provider (required for real analysis) ----
AI_PROVIDER=openai
# Your OpenAI API key. Keep this server-side only; never put it in frontend code.
OPENAI_API_KEY=sk-...
# Vision-capable model. If the one you set is unavailable to your account, the app
# automatically falls back to a supported vision model (gpt-4o, gpt-4o-mini, …).
AI_MODEL=gpt-4o

# ---- Auth (single teacher) ----
# The password the teacher types to log in.
TEACHER_PASSWORD=changeme
# Secret used to sign the session cookie. Use a long random string in production.
SECRET_KEY=please-change-this-to-a-long-random-string

# ---- Storage / DB ----
# Directory for the SQLite database and uploaded images.
DATA_DIR=./data

# ---- Server ----
# Set to 1 only when serving over HTTPS in production (marks the session cookie Secure).
COOKIE_SECURE=0
# Max upload size per image, in megabytes.
MAX_UPLOAD_MB=15
